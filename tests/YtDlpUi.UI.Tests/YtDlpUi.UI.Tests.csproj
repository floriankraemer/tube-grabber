<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <Include>[YtDlpUi.UI]*</Include>
    <Exclude>[YtDlpUi.UI]YtDlpUi.UI.App,[YtDlpUi.UI]YtDlpUi.UI.Program,[YtDlpUi.UI]YtDlpUi.UI.Views.*</Exclude>
    <ExcludeByFile>**/Views/**,**/Program.cs,**/App.axaml.cs,**/Services/AppServices.cs,**/Services/FileSystemLauncherService.cs,**/Services/StoragePickerService.cs,**/Services/Notifications/*Notifier.cs,**/*MainWindowViewModel.cs,**/*SettingsViewModel.cs</ExcludeByFile>
    <CoverageThreshold>85</CoverageThreshold>
    <CoverageThresholdType>line</CoverageThresholdType>
  </PropertyGroup>

  <!-- `make coverage` passes -p:Coverage=true; plain `dotnet test` stays coverage-free. Coverlet CLI options are not comma-split, hence the Replace. -->
  <PropertyGroup Condition="'$(Coverage)' == 'true'">
    <TestingPlatformCommandLineArguments>--coverlet --coverlet-output-format cobertura --coverlet-include "$(Include)" --coverlet-exclude "$(Exclude.Replace(',', '" --coverlet-exclude "'))" --coverlet-exclude-by-file "$(ExcludeByFile.Replace(',', '" --coverlet-exclude-by-file "'))" --coverlet-threshold $(CoverageThreshold) --coverlet-threshold-type $(CoverageThresholdType) --coverlet-threshold-stat Total --coverlet-file-prefix $(MSBuildProjectName) --results-directory $(MSBuildThisFileDirectory)../../artifacts/coverage</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.mtp" Version="10.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\YtDlpUi.UI\YtDlpUi.UI.csproj" />
  </ItemGroup>

</Project>
