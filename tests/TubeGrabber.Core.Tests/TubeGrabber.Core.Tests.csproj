<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <Include>[TubeGrabber.Core]*</Include>
    <Exclude>[TubeGrabber.Core]TubeGrabber.Core.Constants.*,[TubeGrabber.Core]TubeGrabber.Core.Models.*,[TubeGrabber.Core]TubeGrabber.Core.Abstractions.*</Exclude>
    <ExcludeByFile>**/YtDlpProcessRunner.cs,**/BinaryDownloadHelper.cs,**/FfmpegBinaryInstaller.cs,**/YtDlpBinaryInstaller.cs,**/GitHubBinaryReleaseSource.cs</ExcludeByFile>
    <CoverageThreshold>85</CoverageThreshold>
    <CoverageThresholdType>method</CoverageThresholdType>
  </PropertyGroup>

  <!-- `make coverage` passes -p:Coverage=true; plain `dotnet test` stays coverage-free. Coverlet CLI options are not comma-split, hence the Replace. -->
  <PropertyGroup Condition="'$(Coverage)' == 'true'">
    <TestingPlatformCommandLineArguments>--coverlet --coverlet-output-format cobertura --coverlet-include "$(Include)" --coverlet-exclude "$(Exclude.Replace(',', '" --coverlet-exclude "'))" --coverlet-exclude-by-file "$(ExcludeByFile.Replace(',', '" --coverlet-exclude-by-file "'))" --coverlet-threshold $(CoverageThreshold) --coverlet-threshold-type $(CoverageThresholdType) --coverlet-threshold-stat Total --coverlet-file-prefix $(MSBuildProjectName) --results-directory $(MSBuildThisFileDirectory)../../artifacts/coverage</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.mtp" Version="10.1.0" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TubeGrabber.Core\TubeGrabber.Core.csproj" />
  </ItemGroup>

</Project>
