<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:YtDlpUi.UI.ViewModels"
        xmlns:models="clr-namespace:YtDlpUi.Core.Constants;assembly=YtDlpUi.Core"
        x:Class="YtDlpUi.UI.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Width="920"
        Height="650"
        MinWidth="720"
        MinHeight="500"
        WindowStartupLocation="CenterOwner">
  <Grid ColumnDefinitions="200,*">
    <Border Grid.Column="0"
            Padding="12,12,12,12"
            BorderThickness="0,0,1,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <ListBox x:Name="SectionList" />
    </Border>

    <DockPanel Grid.Column="1" Margin="12">
      <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
        <TextBlock Text="{Binding StatusMessage}"
                   Opacity="0.9"
                   TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding StatusMessage}" />
        <TextBlock Text="{Binding ValidationError}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="Cancel" Click="Cancel_Click" />
          <Button Content="Save" Click="Save_Click" />
        </StackPanel>
      </StackPanel>

      <Panel x:Name="SectionPanelsHost">
        <ScrollViewer x:Name="AppearancePanel" IsVisible="False">
          <StackPanel Spacing="16" Margin="8">
            <StackPanel Spacing="4">
              <TextBlock Text="Appearance" FontWeight="SemiBold" FontSize="16" />
              <TextBlock Text="Choose light, dark, or follow your operating system theme."
                         TextWrapping="Wrap"
                         Opacity="0.8" />
            </StackPanel>
            <StackPanel Spacing="8">
              <TextBlock Text="Theme" FontWeight="SemiBold" />
              <ComboBox ItemsSource="{Binding ThemePreferenceOptions}"
                        SelectedItem="{Binding ThemePreference}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="BackgroundPanel" IsVisible="False">
          <StackPanel Spacing="16" Margin="8">
            <StackPanel Spacing="4">
              <TextBlock Text="Background" FontWeight="SemiBold" FontSize="16" />
              <TextBlock Text="Keep checking channel subscriptions while the window is closed."
                         TextWrapping="Wrap"
                         Opacity="0.8" />
            </StackPanel>
            <StackPanel Spacing="8">
              <CheckBox Content="Keep running in the system tray when the window is closed"
                        IsChecked="{Binding RunInBackground}" />
              <CheckBox Content="Start at login (minimized to tray)"
                        IsChecked="{Binding StartAtLogin}" />
            </StackPanel>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" RowDefinitions="Auto" RowSpacing="8">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Check subscriptions every" VerticalAlignment="Center" />
              <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <NumericUpDown Minimum="15"
                               Maximum="1440"
                               ClipValueToMinMax="True"
                               Increment="15"
                               FormatString="0"
                               Value="{Binding SubscriptionCheckIntervalMinutes}" />
                <TextBlock Text="minutes" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="BinariesPanel" IsVisible="False">
          <StackPanel Spacing="16" Margin="8">
            <StackPanel Spacing="4">
              <TextBlock Text="Binaries" FontWeight="SemiBold" FontSize="16" />
              <TextBlock Text="Set paths to yt-dlp, ffmpeg, and a JavaScript runtime for YouTube (required by yt-dlp since 2025.11.12). Install downloads the latest build for your operating system; Releases opens GitHub if you prefer to pick a version or install manually. Leave paths blank to use tools on PATH."
                         TextWrapping="Wrap"
                         Opacity="0.8" />
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Text="yt-dlp" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                <TextBox Grid.Column="0"
                         Watermark="{Binding YtDlpPathPlaceholder}"
                         Text="{Binding YtDlpPath}" />
                <Button Grid.Column="1" Content="Browse…" Click="BrowseYtDlp_Click" />
                <Button Grid.Column="2" Content="Test" Click="TestYtDlp_Click" />
                <Button Grid.Column="3" Content="Install" Click="InstallYtDlp_Click" />
                <Button Grid.Column="4" Content="Releases" Click="OpenYtDlpReleases_Click" />
              </Grid>
              <TextBlock FontSize="12" Opacity="0.75"
                         TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding ResolvedYtDlpPath}">
                <Run Text="Resolved: " />
                <Run Text="{Binding ResolvedYtDlpPath}" />
              </TextBlock>
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Text="ffmpeg" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                <TextBox Grid.Column="0"
                         Watermark="{Binding FfmpegPathPlaceholder}"
                         Text="{Binding FfmpegPath}" />
                <Button Grid.Column="1" Content="Browse…" Click="BrowseFfmpeg_Click" />
                <Button Grid.Column="2" Content="Test" Click="TestFfmpeg_Click" />
                <Button Grid.Column="3" Content="Install" Click="InstallFfmpeg_Click" />
                <Button Grid.Column="4" Content="Releases" Click="OpenFfmpegReleases_Click" />
              </Grid>
              <TextBlock FontSize="12" Opacity="0.75"
                         TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding ResolvedFfmpegPath}">
                <Run Text="Resolved: " />
                <Run Text="{Binding ResolvedFfmpegPath}" />
              </TextBlock>
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Text="JavaScript runtime (YouTube)" FontWeight="SemiBold" />
              <TextBlock Text="{Binding JsRuntimeDescription}"
                         TextWrapping="Wrap"
                         FontSize="12"
                         Opacity="0.75" />
              <Grid ColumnDefinitions="220,*" ColumnSpacing="8">
                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding JsRuntimeEngineOptions}"
                          SelectedItem="{Binding SelectedJsRuntimeEngine}"
                          VerticalAlignment="Center">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:JsRuntimeEngineDefinition">
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBox Grid.Column="1"
                         IsEnabled="{Binding IsJsRuntimePathEnabled}"
                         Watermark="{Binding JsRuntimePathPlaceholder}"
                         Text="{Binding JsRuntimePath}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0"
                           FontSize="12"
                           Opacity="0.75"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding ResolvedJsRuntimePath}"
                           VerticalAlignment="Center">
                  <Run Text="Resolved: " />
                  <Run Text="{Binding ResolvedJsRuntimePath}" />
                </TextBlock>
                <Button Grid.Column="1"
                        Content="Browse…"
                        IsEnabled="{Binding IsJsRuntimePathEnabled}"
                        Click="BrowseJsRuntime_Click" />
                <Button Grid.Column="2"
                        Content="Test"
                        IsEnabled="{Binding IsJsRuntimePathEnabled}"
                        Click="TestJsRuntime_Click" />
                <Button Grid.Column="3"
                        Content="Install"
                        IsEnabled="{Binding IsDenoInstallEnabled}"
                        Click="InstallDeno_Click" />
                <Button Grid.Column="4"
                        Content="Releases"
                        IsEnabled="{Binding IsDenoInstallEnabled}"
                        Click="OpenDenoReleases_Click" />
              </Grid>
              <TextBlock FontSize="12" Opacity="0.75"
                         TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding JsRuntimesArgumentPreview}">
                <Run Text="yt-dlp argument: " />
                <Run Text="{Binding JsRuntimesArgumentPreview}" />
              </TextBlock>
            </StackPanel>

            <ProgressBar Height="4"
                         IsIndeterminate="True"
                         IsVisible="{Binding IsInstalling}" />
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="QueuePanel" IsVisible="False">
          <StackPanel Spacing="16" Margin="8">
            <StackPanel Spacing="4">
              <TextBlock Text="Queue" FontWeight="SemiBold" FontSize="16" />
              <TextBlock Text="Default folder for new downloads. Profile option -P overrides this when set."
                         TextWrapping="Wrap"
                         Opacity="0.8" />
            </StackPanel>
            <StackPanel Spacing="8">
              <TextBlock Text="Download folder" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Grid.Column="0"
                         Watermark="{Binding DownloadFolderPlaceholder}"
                         Text="{Binding DownloadFolder}" />
                <Button Grid.Column="1" Content="Browse…" Click="BrowseDownloadFolder_Click" />
              </Grid>
            </StackPanel>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" RowDefinitions="Auto" RowSpacing="8">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Max concurrent downloads" VerticalAlignment="Center" />
              <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="1" Maximum="8" ClipValueToMinMax="True" HorizontalAlignment="Left" Value="{Binding MaxConcurrentDownloads}" />
            </Grid>
          </StackPanel>
        </ScrollViewer>

        <Grid x:Name="ProfilesPanel" IsVisible="False" ColumnDefinitions="200,*" Margin="8">
          <StackPanel Grid.Column="0" Spacing="8">
            <ListBox x:Name="ProfilesList" ItemsSource="{Binding Profiles}" />
            <TextBox Watermark="New profile name" Text="{Binding NewProfileName}" />
            <Button Content="Create profile" Click="CreateProfile_Click" />
            <Button Content="Duplicate" Click="DuplicateProfile_Click" />
            <Button Content="Delete" Click="DeleteProfile_Click" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="8">
            <TextBlock Text="Profile name" />
            <TextBox Text="{Binding Profile.Name}" />
          </StackPanel>
        </Grid>

        <ScrollViewer x:Name="AdvancedPanel" IsVisible="False">
          <StackPanel Spacing="8" Margin="8">
            <TextBlock Text="Extra arguments (quote-aware). Malformed args can break downloads."
                       TextWrapping="Wrap" Opacity="0.8" />
            <TextBox AcceptsReturn="True" MinHeight="80" Text="{Binding ExtraArgs}" />
            <TextBlock Text="CLI preview" FontWeight="SemiBold" />
            <TextBox IsReadOnly="True" Text="{Binding CliPreview}" TextWrapping="Wrap" MinHeight="100" />
          </StackPanel>
        </ScrollViewer>
      </Panel>
    </DockPanel>
  </Grid>
</Window>
