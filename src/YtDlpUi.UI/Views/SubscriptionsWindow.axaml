<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:YtDlpUi.UI.ViewModels"
        xmlns:models="clr-namespace:YtDlpUi.Core.Models;assembly=YtDlpUi.Core"
        x:Class="YtDlpUi.UI.Views.SubscriptionsWindow"
        x:DataType="vm:SubscriptionsViewModel"
        Title="Subscriptions"
        Width="900"
        Height="640"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector=":is(Control).dimmed">
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="ProgressBar.idle">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="DockPanel.addRow > Button">
      <Setter Property="Height" Value="32" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Window.Styles>
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
      <TextBlock Text="Checking subscriptions…"
                 IsVisible="{Binding IsChecking}" />
      <TextBlock Text="{Binding StatusMessage}"
                 TextWrapping="Wrap" />
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <TextBlock Grid.Column="0"
                   Text="Checked periodically (change interval in Settings → Background)."
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center" />
        <Button Grid.Column="1"
                Content="Check now"
                IsEnabled="{Binding CanCheckNow}"
                Click="CheckNow_Click" />
        <Button Grid.Column="2" Content="Close" Click="Close_Click" />
      </Grid>
    </StackPanel>

    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
      <DockPanel Classes="addRow" LastChildFill="True">
        <Button DockPanel.Dock="Right" Margin="8,0,0,0"
                Content="Subscribe"
                IsEnabled="{Binding CanSubscribe}"
                Click="Subscribe_Click" />
        <ComboBox DockPanel.Dock="Right" Margin="8,0,0,0"
                  MinWidth="180"
                  MaxWidth="240"
                  ItemsSource="{Binding Profiles}"
                  SelectedItem="{Binding SelectedProfile}"
                  PlaceholderText="Profile"
                  VerticalAlignment="Center">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="models:DownloadProfile">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBox
                 PlaceholderText="https://www.youtube.com/@channel"
                 Text="{Binding ChannelUrl}"
                 KeyDown="ChannelUrl_KeyDown" />
      </DockPanel>
      <ProgressBar Height="4"
                   Classes.idle="{Binding !IsBusy}"
                   IsIndeterminate="{Binding IsBusy}" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Download latest" VerticalAlignment="Center" />
        <NumericUpDown Value="{Binding BacklogCount}"
                       Minimum="0"
                       Maximum="30"
                       Increment="1"
                       FormatString="0"
                       Width="120" />
        <TextBlock Text="existing videos" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Text="{Binding ErrorMessage}"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />
    </StackPanel>

    <Grid>
      <TextBlock Text="No subscriptions yet. Paste a channel URL above to subscribe."
                 Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                 TextWrapping="Wrap"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 IsVisible="{Binding !HasItems}" />
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SubscriptionItemViewModel">
              <Border Padding="8"
                      Margin="0,0,0,8"
                      BorderThickness="1"
                      BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                      CornerRadius="4">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12">
                  <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4"
                              Classes.dimmed="{Binding !Enabled}">
                    <TextBlock Text="{Binding ChannelName}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ChannelUrl}"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding LastCheckedDisplay}"
                               FontSize="12" />
                    <TextBlock Text="{Binding LastError}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               IsVisible="{Binding HasError}"
                               Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />
                  </StackPanel>

                  <ComboBox Grid.Column="1"
                            MinWidth="160"
                            MaxWidth="220"
                            Classes.dimmed="{Binding !Enabled}"
                            ItemsSource="{Binding Profiles}"
                            SelectedItem="{Binding SelectedProfile}"
                            PlaceholderText="Profile"
                            VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="models:DownloadProfile">
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>

                  <CheckBox Grid.Column="2"
                            Content="Enabled"
                            IsChecked="{Binding Enabled}"
                            VerticalAlignment="Center" />

                  <Button Grid.Column="3"
                          Content="Remove"
                          Classes.dimmed="{Binding !Enabled}"
                          VerticalAlignment="Center"
                          Click="Remove_Click" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
