          <SolidColorBrush x:Key="AppTextBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#C9C9C9" />
          <SolidColorBrush x:Key="AppTextTertiaryBrush" Color="#A8A8A8" />
          <SolidColorBrush x:Key="AppAccentBrush" Color="#60CDFF" />
          <SolidColorBrush x:Key="AppOnAccentBrush" Color="#000000" />
          <SolidColorBrush x:Key="AppSuccessBrush" Color="#6CCB5F" />
          <SolidColorBrush x:Key="AppErrorBrush" Color="#FF99A4" />
          <SolidColorBrush x:Key="AppErrorBackgroundBrush" Color="#442726" />
          <SolidColorBrush x:Key="AppSubtleBrush" Color="#0FFFFFFF" />
          <SolidColorBrush x:Key="AppSubtlePressedBrush" Color="#17FFFFFF" />
