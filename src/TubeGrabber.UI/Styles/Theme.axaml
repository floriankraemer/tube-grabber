          <StaticResource x:Key="DataGridRowSelectedBackgroundBrush" ResourceKey="AppSubtlePressedBrush" />
          <StaticResource x:Key="DataGridRowSelectedHoveredBackgroundBrush" ResourceKey="AppSubtlePressedBrush" />
          <StaticResource x:Key="DataGridRowSelectedUnfocusedBackgroundBrush" ResourceKey="AppSubtleBrush" />
          <StaticResource x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundBrush" ResourceKey="AppSubtlePressedBrush" />
          <x:Double x:Key="DataGridRowSelectedBackgroundOpacity">1</x:Double>
          <x:Double x:Key="DataGridRowSelectedHoveredBackgroundOpacity">1</x:Double>
          <x:Double x:Key="DataGridRowSelectedUnfocusedBackgroundOpacity">1</x:Double>
          <x:Double x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundOpacity">1</x:Double>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- Fluent defaults are 3 / 8; the design uses 4 for controls. OverlayCornerRadius (8) is used for cards and the page layer. -->
      <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
      <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
      <Thickness x:Key="TextControlBorderThemeThicknessFocused">1,1,1,2</Thickness>

      <!-- Sidebar item: 36px row, subtle pill when hovered or selected, accent bar when selected, focus ring for keyboard. -->
      <ControlTheme x:Key="NavListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="4,1" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel>
              <Border x:Name="PART_Pill"
                      Background="Transparent"
                      BorderBrush="Transparent"
                      BorderThickness="2"
                      CornerRadius="{DynamicResource ControlCornerRadius}">
                <ContentPresenter x:Name="PART_ContentPresenter"
                                  Padding="{TemplateBinding Padding}"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Foreground="{TemplateBinding Foreground}"
                                  VerticalContentAlignment="Center" />
              </Border>
              <Border x:Name="PART_Indicator"
                      Width="3"
                      Height="16"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      CornerRadius="2"
                      Background="{DynamicResource AppAccentBrush}"
                      IsVisible="False" />
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#PART_Pill">
          <Setter Property="Background" Value="{DynamicResource AppSubtleBrush}" />
        </Style>
        <Style Selector="^:selected /template/ Border#PART_Pill">
          <Setter Property="Background" Value="{DynamicResource AppSubtleBrush}" />
        </Style>
        <Style Selector="^:selected:pointerover /template/ Border#PART_Pill">
          <Setter Property="Background" Value="{DynamicResource AppSubtlePressedBrush}" />
        </Style>
        <Style Selector="^:selected /template/ Border#PART_Indicator">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_Pill">
          <Setter Property="BorderBrush" Value="{DynamicResource AppFocusBrush}" />
        </Style>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Text: 28 page title, 14 row title, 13 meta, 12 caption. Body is the Fluent default (14). -->
  <Style Selector="TextBlock.pageTitle">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="LineHeight" Value="36" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.rowTitle">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.meta">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.success">
    <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{DynamicResource AppErrorBrush}" />
  </Style>

  <!-- Surfaces. Border.layer is the rounded page layer owned by MainWindow; Border.card is for content blocks inside pages. -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource AppCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
  </Style>
  <!-- Small status pill ("Built-in", "Unsaved", "3 changed"). -->
  <Style Selector="Border.pill">
    <Setter Property="Background" Value="{DynamicResource AppSubtlePressedBrush}" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="MinHeight" Value="18" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.pill > TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
  </Style>
  <Style Selector="Border.pill.accent">
    <Setter Property="Background" Value="{DynamicResource AppAccentSubtleBrush}" />
  </Style>
  <Style Selector="Border.pill.accent > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
  </Style>

  <Style Selector="Border.divider">
    <Setter Property="BorderBrush" Value="{DynamicResource AppDividerBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>

  <!-- Small icon-only button (32x32). Always give it ToolTip.Tip and AutomationProperties.Name. -->
  <Style Selector="Button.icon">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppSubtleBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>
  <Style Selector="Button.icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppSubtlePressedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>
  <Style Selector="Button.icon:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource AppFocusBrush}" />
  </Style>
  <Style Selector="Button.icon:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>

  <!-- Destructive primary action (Delete): white text on red, never the pink error text colour. -->
  <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppDangerBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AppOnDangerBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppDangerHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppOnDangerBrush}" />
  </Style>
  <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppDangerPressedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppOnDangerBrush}" />
  </Style>

  <!-- Transparent list used for the sidebar. -->
  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ItemContainerTheme" Value="{StaticResource NavListBoxItem}" />
  </Style>
</Styles>
