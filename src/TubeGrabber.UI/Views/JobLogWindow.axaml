<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TubeGrabber.UI.Views.JobLogWindow"
        Width="800"
        Height="500"
        MinWidth="500"
        MinHeight="300"
        Background="{DynamicResource AppWindowBackgroundBrush}">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom"
                Orientation="Horizontal"
                Spacing="8"
                HorizontalAlignment="Right"
                Margin="0,16,0,0">
      <Button Content="Close" Click="Close_Click" />
    </StackPanel>

    <Border Classes="card" ClipToBounds="True">
      <ScrollViewer HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
        <TextBox x:Name="LogTextBox"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 FontFamily="Cascadia Mono, SF Mono, JetBrains Mono, DejaVu Sans Mono, monospace"
                 FontSize="13"
                 Padding="12"
                 BorderThickness="0"
                 Background="Transparent" />
      </ScrollViewer>
    </Border>
  </DockPanel>
</Window>
