<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TubeGrabber.UI.ViewModels"
             xmlns:ui="clr-namespace:TubeGrabber.UI.Controls"
             xmlns:vlc="clr-namespace:LibVLCSharp.Avalonia;assembly=LibVLCSharp.Avalonia"
             x:Class="TubeGrabber.UI.Views.WatchView"
             x:DataType="vm:WatchViewModel">
  <UserControl.Styles>
    <Style Selector="Button.control">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Buffering spinner: a three-quarter arc that turns while the player waits for data. -->
    <Style Selector="ui|Icon.spinner">
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
    </Style>
    <Style Selector="ui|Icon.spinner.on">
      <Style.Animations>
        <Animation Duration="0:0:0.9" IterationCount="INFINITE">
          <KeyFrame Cue="0%">
            <Setter Property="RotateTransform.Angle" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="RotateTransform.Angle" Value="360" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- The skip notice keeps its line while sponsor segments exist, so showing it never moves the page. -->
    <Style Selector="TextBlock.skipNotice">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="TextBlock.skipNotice.on">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>

  <!-- One scroll region for the whole page, so the scrollbar sits at the page's right edge and the player scrolls
       with the content. The column is sized in code: 16:9, as wide as fits (max 1280), at most 70% of the height. -->
  <ThemeVariantScope x:Name="Scope">
  <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled">
  <Grid x:Name="Column" HorizontalAlignment="Left" Margin="32,0,32,24" RowDefinitions="Auto,Auto,Auto,Auto">
    <!-- The video is a native child window: nothing may overlay it, so state and notices sit below it. -->
    <Border x:Name="VideoHost" Grid.Row="0" Background="Black">
      <Panel>
        <vlc:VideoView x:Name="Video" IsVisible="{Binding IsPlaybackAvailable}" />
        <StackPanel IsVisible="{Binding !IsPlaybackAvailable}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Margin="24">
          <TextBlock Text="Video playback needs VLC/libvlc. Install it to watch here."
                     Foreground="White" TextAlignment="Center" TextWrapping="Wrap" />
          <Button Content="Open in browser" HorizontalAlignment="Center" Click="OpenInBrowser_Click" />
        </StackPanel>
      </Panel>
    </Border>

    <Grid x:Name="Controls" Grid.Row="1" ColumnDefinitions="Auto,22,Auto,*,Auto,110,Auto" Margin="0,4,0,0"
          IsVisible="{Binding IsPlaybackAvailable}">
      <Button Grid.Column="0" Classes="control" Click="PlayPause_Click"
              AutomationProperties.Name="Play or pause" ToolTip.Tip="Play / Pause">
        <Panel>
          <ui:Icon Data="{DynamicResource IconPlay}" Width="20" Height="20" IsVisible="{Binding !IsPlaying}" />
          <ui:Icon Data="{DynamicResource IconPause}" Width="20" Height="20" IsVisible="{Binding IsPlaying}" />
        </Panel>
      </Button>
      <!-- Fixed slot, so the controls do not shift when the spinner appears. -->
      <ui:Icon Grid.Column="1" Classes="spinner" Classes.on="{Binding IsBuffering}"
               Data="{DynamicResource IconSpinner}" Width="16" Height="16" IsVisible="{Binding IsBuffering}"
               Foreground="{DynamicResource AppTextSecondaryBrush}" StrokeThickness="2"
               ToolTip.Tip="Buffering" />
      <TextBlock Grid.Column="2" Classes="meta" Text="{Binding TimeText}" VerticalAlignment="Center"
                 Margin="0,0,12,0" MinWidth="88" />
      <!-- The rail, played part and sponsor segments are drawn by SeekTrack under a transparent Slider, so the
           thumb stays on top. Fluent insets the track by half the thumb width (10px); SeekTrack matches it. -->
      <Panel Grid.Column="3" VerticalAlignment="Center">
        <ui:SeekTrack Margin="10,0" VerticalAlignment="Center"
                      Segments="{Binding Segments}" Length="{Binding LengthSeconds}" Position="{Binding SeekValue}"
                      RailBrush="{DynamicResource AppStrokeStrongBrush}" PlayedBrush="{DynamicResource AppAccentBrush}" />
        <Slider x:Name="SeekSlider"
                Classes="seek"
                Minimum="0"
                Maximum="{Binding LengthSeconds}"
                Value="{Binding SeekValue}"
                IsEnabled="{Binding CanSeek}"
                AutomationProperties.Name="Seek">
          <Slider.Resources>
            <SolidColorBrush x:Key="SliderTrackFill" Color="Transparent" />
            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="SliderTrackFillPressed" Color="Transparent" />
            <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="Transparent" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="Transparent" />
            <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="Transparent" />
          </Slider.Resources>
        </Slider>
      </Panel>
      <ui:Icon Grid.Column="4" Data="{DynamicResource IconVolume}" Width="18" Height="18" Margin="16,0,0,0"
               Foreground="{DynamicResource AppTextSecondaryBrush}" />
      <Slider Grid.Column="5" Minimum="0" Maximum="100" Value="{Binding Volume}" Margin="4,0,0,0"
              VerticalAlignment="Center" AutomationProperties.Name="Volume" />
      <Button Grid.Column="6" Classes="control" Click="Fullscreen_Click"
              AutomationProperties.Name="Toggle fullscreen" ToolTip.Tip="Fullscreen (Esc to exit)">
        <ui:Icon Data="{DynamicResource IconFullscreen}" Width="18" Height="18" />
      </Button>
    </Grid>

    <!-- Status strip below the video. -->
    <StackPanel x:Name="Status" Grid.Row="2" Spacing="6">
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding ShowPlaybackSpinner}" Margin="0,4,0,0" />
      <TextBlock Classes="meta" Text="Loading video…" IsVisible="{Binding ShowPlaybackSpinner}" />
      <TextBlock Classes="meta skipNotice" Classes.on="{Binding HasSkipNotice}" Text="Skipped sponsor segment"
                 IsVisible="{Binding HasSegments}" Foreground="{DynamicResource AppSuccessBrush}" />
      <TextBlock Classes="error" Text="{Binding PlaybackError}" IsVisible="{Binding HasPlaybackError}"
                 TextWrapping="Wrap" />
      <Border IsVisible="{Binding HasDetailsError}" Padding="12" CornerRadius="6"
              Background="{DynamicResource AppErrorBackgroundBrush}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Retry" Click="RetryDetails_Click" />
          <TextBlock Classes="error" Text="{Binding DetailsError}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
      </Border>
    </StackPanel>

    <StackPanel x:Name="Info" Grid.Row="3" Spacing="14" Margin="0,8,0,0">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <TextBlock Classes="rowTitle" FontSize="20" LineHeight="28" Text="{Binding Title}" TextWrapping="Wrap"
                     VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Top">
            <Button x:Name="DownloadButton" Classes="accent" IsEnabled="{Binding !IsDownloading}"
                    AutomationProperties.Name="Download with a profile">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ui:Icon Data="{DynamicResource IconDownload}" Width="16" Height="16" />
                <TextBlock Text="Download" />
                <ui:Icon Data="{DynamicResource IconChevronDown}" Width="14" Height="14" />
              </StackPanel>
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight" />
              </Button.Flyout>
            </Button>
          </StackPanel>
        </Grid>

        <DockPanel IsVisible="{Binding HasDownloadMessage}" LastChildFill="True">
          <Button DockPanel.Dock="Right" Content="View downloads" Margin="12,0,0,0"
                  IsVisible="{Binding DownloadSucceeded}" Click="ViewDownloads_Click" />
          <TextBlock Classes="success" Text="{Binding DownloadMessage}" IsVisible="{Binding DownloadSucceeded}"
                     VerticalAlignment="Center" />
          <TextBlock Classes="error" Text="{Binding DownloadMessage}" IsVisible="{Binding !DownloadSucceeded}"
                     TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>

        <StackPanel Spacing="2">
          <TextBlock Classes="rowTitle" Text="{Binding Channel}" />
          <TextBlock Classes="meta" Text="{Binding StatsLine}" />
        </StackPanel>

        <Border Classes="card" Padding="14" IsVisible="{Binding HasDescription}">
          <StackPanel Spacing="6">
            <SelectableTextBlock x:Name="DescriptionText" Text="{Binding Description}" TextWrapping="Wrap"
                                 MaxLines="3" TextTrimming="CharacterEllipsis" />
            <Button Content="{Binding DescriptionToggleText}" IsVisible="{Binding CanExpandDescription}"
                    Click="ToggleDescription_Click" Padding="0" Background="Transparent" BorderThickness="0"
                    Foreground="{DynamicResource AppAccentBrush}" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>

        <Border Classes="divider" />
        <TextBlock Classes="rowTitle" FontSize="16" Text="{Binding CommentsHeader}" />

        <StackPanel Spacing="6" IsVisible="{Binding IsLoadingComments}">
          <ProgressBar IsIndeterminate="True" Width="160" HorizontalAlignment="Left" />
          <TextBlock Classes="meta" Text="Loading comments…" />
        </StackPanel>
        <Border IsVisible="{Binding HasCommentsError}" Padding="12" CornerRadius="6"
                Background="{DynamicResource AppErrorBackgroundBrush}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Retry" Click="RetryComments_Click" />
            <TextBlock Classes="error" Text="{Binding CommentsError}" TextWrapping="Wrap" VerticalAlignment="Center" />
          </DockPanel>
        </Border>
        <TextBlock Classes="meta" IsVisible="{Binding ShowNoComments}"
                   Text="Comments are turned off or there are none yet." />

        <ItemsControl ItemsSource="{Binding Comments}" IsVisible="{Binding HasComments}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CommentViewModel">
              <StackPanel Spacing="3" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock FontWeight="SemiBold" Text="{Binding Author}" VerticalAlignment="Center" />
                  <Border Classes="pill accent" IsVisible="{Binding IsUploader}"><TextBlock Text="Uploader" /></Border>
                  <Border Classes="pill" IsVisible="{Binding IsPinned}"><TextBlock Text="Pinned" /></Border>
                  <TextBlock Classes="caption" Text="{Binding PostedAgo}" VerticalAlignment="Center" />
                </StackPanel>
                <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                <TextBlock Classes="caption" Text="{Binding Likes}"
                           IsVisible="{Binding Likes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
  </Grid>
  </ScrollViewer>
  </ThemeVariantScope>
</UserControl>
