<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TubeGrabber.UI.ViewModels"
             xmlns:ui="clr-namespace:TubeGrabber.UI.Controls"
             xmlns:models="clr-namespace:TubeGrabber.Core.Models;assembly=TubeGrabber.Core"
             x:Class="TubeGrabber.UI.Views.SubscriptionsView"
             x:DataType="vm:SubscriptionsViewModel">
  <UserControl.Styles>
    <Style Selector=":is(Control).dimmed">
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="ProgressBar.idle">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Grid.addRow > :is(Control)">
      <Setter Property="Height" Value="36" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="32,28,32,16">
    <StackPanel Grid.Row="0" Spacing="2">
      <TextBlock Classes="pageTitle" Text="Subscriptions" />
      <TextBlock Classes="meta" Text="{Binding CountText}" />
    </StackPanel>

    <Grid Grid.Row="1" Classes="addRow" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,20,0,8">
      <TextBox Grid.Column="0"
               PlaceholderText="https://www.youtube.com/@channel"
               Text="{Binding ChannelUrl}"
               VerticalContentAlignment="Center"
               AutomationProperties.Name="Channel URL"
               KeyDown="ChannelUrl_KeyDown">
        <TextBox.InnerLeftContent>
          <ui:Icon Data="{DynamicResource IconLink}" Width="16" Height="16" Margin="10,0,0,0"
                   Foreground="{DynamicResource AppTextTertiaryBrush}" />
        </TextBox.InnerLeftContent>
      </TextBox>
      <ComboBox Grid.Column="1"
                MinWidth="180"
                MaxWidth="240"
                ItemsSource="{Binding Profiles}"
                SelectedItem="{Binding SelectedProfile}"
                PlaceholderText="Profile"
                VerticalContentAlignment="Center">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="models:DownloadProfile">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button Grid.Column="2"
              Classes="accent"
              Content="Subscribe"
              VerticalContentAlignment="Center"
              IsEnabled="{Binding CanSubscribe}"
              Click="Subscribe_Click" />
      <Button Grid.Column="3"
              IsEnabled="{Binding CanCheckNow}"
              VerticalContentAlignment="Center"
              Click="CheckNow_Click">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <ui:Icon Data="{DynamicResource IconRefresh}" Width="16" Height="16" />
          <TextBlock Text="Check now" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
      <TextBlock Classes="meta" Text="Download latest" VerticalAlignment="Center" />
      <NumericUpDown Value="{Binding BacklogCount}"
                     Minimum="0"
                     Maximum="30"
                     Increment="1"
                     FormatString="0"
                     Width="120" />
      <TextBlock Classes="meta" Text="existing videos when subscribing" VerticalAlignment="Center" />
    </StackPanel>

    <StackPanel Grid.Row="3" Spacing="6" Margin="0,12,0,12">
      <ProgressBar Height="4"
                   Classes.idle="{Binding !IsWorking}"
                   IsIndeterminate="{Binding IsWorking}" />
      <TextBlock Classes="meta" Text="Checking subscriptions…" IsVisible="{Binding IsChecking}" />
      <TextBlock Classes="meta" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                 IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Classes="error" Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>

    <Grid Grid.Row="4">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                  IsVisible="{Binding !HasItems}">
        <ui:Icon Data="{DynamicResource IconSubscriptions}" Width="40" Height="40" HorizontalAlignment="Center"
                 Foreground="{DynamicResource AppTextTertiaryBrush}" />
        <TextBlock Classes="rowTitle" Text="No subscriptions yet" HorizontalAlignment="Center" />
        <TextBlock Classes="meta" Text="Paste a channel URL above to subscribe." HorizontalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>
      <ScrollViewer IsVisible="{Binding HasItems}" Margin="0,0,-12,0">
        <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,12,8">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SubscriptionItemViewModel">
              <Border Classes="card" Padding="12" Margin="0,0,0,8">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="12">
                  <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" VerticalAlignment="Center"
                          Background="{DynamicResource AppSubtleBrush}"
                          Classes.dimmed="{Binding !Enabled}">
                    <TextBlock Text="{Binding Initial}" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                  </Border>

                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"
                              Classes.dimmed="{Binding !Enabled}">
                    <TextBlock Classes="rowTitle" Text="{Binding ChannelName}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="meta" Text="{Binding ChannelUrl}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="caption" Text="{Binding LastCheckedDisplay}" />
                    <TextBlock Classes="error" Text="{Binding LastError}" TextWrapping="Wrap"
                               IsVisible="{Binding HasError}" />
                  </StackPanel>

                  <ComboBox Grid.Column="2"
                            MinWidth="160"
                            MaxWidth="220"
                            Classes.dimmed="{Binding !Enabled}"
                            ItemsSource="{Binding Profiles}"
                            SelectedItem="{Binding SelectedProfile}"
                            PlaceholderText="Profile"
                            AutomationProperties.Name="Profile"
                            VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="models:DownloadProfile">
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>

                  <CheckBox Grid.Column="3"
                            Content="Enabled"
                            IsChecked="{Binding Enabled}"
                            VerticalAlignment="Center" />

                  <Button Grid.Column="4"
                          Classes="icon"
                          VerticalAlignment="Center"
                          ToolTip.Tip="Remove subscription"
                          AutomationProperties.Name="Remove subscription"
                          Click="Remove_Click">
                    <ui:Icon Data="{DynamicResource IconTrash}" Width="16" Height="16" />
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
